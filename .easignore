# What EAS uploads. When this file exists it REPLACES .gitignore for the
# upload, so it must repeat every exclusion we rely on. 2026-10-05: the old
# version excluded assets/icons/crypto-icons (the release bundle failed with
# "Unable to resolve @/assets/icons/crypto-icons/USDC.webp" on EAS only) and
# let the local ios/ and android/ folders through (EAS then skipped prebuild).

# dependencies / build output
node_modules/
.expo/
.expo-shared/
dist/
web-build/
build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*

# generated native folders — EAS runs prebuild itself (CNG)
/ios
/android

# secrets and local config — never uploaded; env comes from EAS environments
.env
.env*.local
credentials/
credentials
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# git / IDE / OS
.git/
.vscode/
.idea/
.DS_Store
*.log
*.swp
*.orig.*

# repo + caches
.git
.tamagui/
