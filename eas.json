{
  "cli": {
    "version": ">= 16.23.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.19.4",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.19.4",
      "env": {
        "APP_VARIANT": "production"
      },
      "environment": "production",
      "channel": "production"
    },
    "staging": {
      "extends": "production",
      "distribution": "store",
      "channel": "staging",
      "environment": "preview",
      "autoIncrement": true,
      "node": "20.19.4",
      "env": {
        "APP_VARIANT": "development"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FA938A596N"
      }
    },
    "staging": {
      "ios": {
        "appleTeamId": "FA938A596N",
        "ascAppId": "6819213065"
      }
    }
  }
}
