{
  "cli": {
    "version": ">= 16.23.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "EAS_BUILD_SKIP_DEPENDENCY_INSTALL": "1"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "EAS_BUILD_SKIP_DEPENDENCY_INSTALL": "1"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "EAS_BUILD_SKIP_DEPENDENCY_INSTALL": "1"
      },
      "autoIncrement": true,
      "node": "20.19.4"
    }
  },
  "submit": {
    "production": {}
  }
}
